import { describe, expect } from 'vitest'
import { screen{{#if display}}, within{{/if}} } from '@testing-library/react'
import { render } from '@/test/util'
import { SidebarProvider } from '@/components/ui/sidebar'
{{#if display}}
import { createFactories } from '@/test/factories'
{{/if}}
import {{pascalCase plural}}Index from '@/features/{{camelCase plural}}/{{pascalCase plural}}Index.tsx'

describe('{{pascalCase plural}}Index', () => {
{{#if display}}

  const { {{camelCase entity}} } = createFactories()

  test('renders all {{camelCase plural}}', () => {
{{#if display.isString}}
    const {{camelCase plural}} = [ {{camelCase entity}}({ {{display.name}}: 'Test 1' }), {{camelCase entity}}({ {{display.name}}: 'Test 2' }) ]
{{else}}
    const {{camelCase plural}} = [ {{camelCase entity}}({ {{display.name}}: 1 }), {{camelCase entity}}({ {{display.name}}: 2 }) ]
{{/if}}

    /* The index reaches the sidebar through its NavBar */
    render(<SidebarProvider><{{pascalCase plural}}Index /></SidebarProvider>)

    const rows = screen.queryAllByRole('row')
    const dataRows = rows.slice(1)

    dataRows.forEach((row, ind) => {
{{#if display.isString}}
      expect(within(row).getByText({{camelCase plural}}[ind].{{display.name}})).toBeInTheDocument()
{{else}}
      expect(within(row).getByText(String({{camelCase plural}}[ind].{{display.name}}))).toBeInTheDocument()
{{/if}}
    })
  })
{{else}}

  /* no string or number field to find the rows by: add a column and a test for it */
  test('renders', () => {
    /* The index reaches the sidebar through its NavBar */
    render(<SidebarProvider><{{pascalCase plural}}Index /></SidebarProvider>)

    expect(screen.getByText('{{labelPlural}}')).toBeInTheDocument()
  })
{{/if}}
})
