import * as z from 'zod'
import { defineFormConfig } from '@/components/Form/util.ts'
import type { Form{{pascalCase entity}}, {{pascalCase entity}} } from '@/features/{{camelCase plural}}/types.ts'
{{#if converted}}
import type { InferSchema } from '@/components/Form/types.ts'
{{/if}}

const fields = {
{{#each fields}}
  {{name}}: {
    label: '{{{label}}}',
    schema: {{{schema}}},
{{#if variation}}
    variation: '{{variation}}' as const,
{{/if}}
  },
{{/each}}
}

export const config = defineFormConfig<{{pascalCase entity}}, Form{{pascalCase entity}}, typeof fields>({
  fields,
{{#if defaults.length}}
  defaultValues: { {{#each defaults}}{{name}}: {{{default}}}{{#unless @last}}, {{/unless}}{{/each}} },
{{/if}}
{{#if converted}}
  /* the form holds the ids of the records the {{camelCase entity}} references, and Dates for its date strings */
  toFormData: ({{camelCase entity}}: {{pascalCase entity}}): InferSchema<typeof fields> => {
    const { {{#each references}}{{reference.object}}, {{/each}}{{#each dates}}{{name}}, {{/each}}...rest } = {{camelCase entity}}

    return {
      ...rest,
{{#each references}}
      {{name}}: {{reference.object}}?.id,
{{/each}}
{{#each dates}}
      {{name}}: {{name}} ? new Date({{name}}) : undefined,
{{/each}}
    }
  },
{{/if}}
})
