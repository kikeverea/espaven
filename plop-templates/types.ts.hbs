import type { PersistedRecord } from '@/types'
{{#each referenceImports}}
import type { {{type}} } from '{{from}}'
{{/each}}

export type {{pascalCase entity}} =
  PersistedRecord &
  {
{{#each fields}}
    {{typeName}}{{#if optional}}?{{/if}}: {{typeType}}
{{/each}}
  }

export type Form{{pascalCase entity}} = Partial<{{pascalCase entity}}>
